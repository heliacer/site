---
import type { InferEntrySchema } from 'astro:content'
import Back from './Back.astro'

interface Props {
  blog: InferEntrySchema<'blog'>
}

const { blog } = Astro.props
const date = blog.upd ?? blog.pub
---

<header>
  <Back href='/blog/'>Blog</Back>
  <h1 class='text-4xl my-4'>
    <span class='text-amber'>{blog.title.charAt(0)}</span>
    {blog.title.substring(1)}
  </h1>
  <p class='my-3 text-ui-400'>{blog.descr}</p>
  <p class='text-sm text-ui-500'>
    {blog.upd ? 'Last updated ' : 'Published '}
    <time datetime={date.toISOString()}>{date.toLocaleDateString()}</time>
  </p>
  <hr class='my-4 text-ui-800' />
</header>
