---
import { getEntry, type InferEntrySchema } from 'astro:content'
import Back from './Back.astro'

interface Props {
  blog: InferEntrySchema<'blog'>
  id: string
}

const { blog, id } = Astro.props
const date = blog.upd ?? blog.pub

const cut = id.lastIndexOf('/')
const parent = cut === -1 ? undefined : await getEntry('blog', id.slice(0, cut))
const href = parent ? `/blog/${parent.id}/` : '/blog/'
const label = parent?.data.title ?? 'Blog'
---

<header>
  <Back href={href}>{label}</Back>
  <div class='max-w-2xl mx-auto 2xl:mx-0'>
    <h1 class='text-4xl my-4'>
      <span class='text-amber'>{blog.title.charAt(0)}</span>
      {blog.title.substring(1)}
    </h1>
    <p class='my-3 text-ui-400'>{blog.descr}</p>
    <p class='text-sm text-ui-500'>
      {blog.upd ? 'Last updated ' : 'Published '}
      <time datetime={date.toISOString()}>{date.toLocaleDateString()}</time>
    </p>
    <hr class='my-4 border-dashed text-ui-800' />
  </div>
</header>
