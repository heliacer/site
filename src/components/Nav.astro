---
import { Moon, Sun } from '@lucide/astro'
const { pathname } = Astro.url

const menus = [
  { path: '/', label: 'Home' },
  { path: '/blog/', label: 'Blog' },
  { path: '/blog/graplet/', label: 'Graplet' }
]
---

<nav class='flex justify-between sm:justify-start gap-4 my-3 items-center'>
  <a href='/' class='active:scale-95'>
    heliacer
    <span class='text-amber'>.</span>
    ch
  </a>
  <ul
    class:list={[
      'fixed sm:static flex gap-0.5 rounded-lg p-0.5',
      'text-sm bg-ui-900/50 border border-ui-800',
      'bottom-0 left-1/2 -translate-1/2 sm:translate-0',
      'backdrop-blur-md z-10'
    ]}
  >
    {menus.map(menu => (
      <li>
        <a
          class:list={[
            'block py-0.5 px-2.5 rounded-md border border-transparent',
            pathname === menu.path
              ? 'bg-amber/25'
              : 'hover:bg-ui-800/50 active:border-ui-950/50'
          ]}
          href={menu.path}
        >
          {menu.label}
        </a>
      </li>
    ))}
  </ul>
  <button
    id='theme'
    class:list={[
      'px-1 py-1 rounded-md hover:bg-ui-900',
      'border border-transparent active:border-ui-950'
    ]}
  >
    <Sun size={14} class='dark:hidden' />
    <Moon size={14} class='hidden dark:block' />
  </button>
</nav>

<script>
  document.getElementById('theme')!.onclick = () =>
    (localStorage.theme = document.documentElement.classList.toggle('dark')
      ? 'dark'
      : 'light')
</script>
