---
import CH from '@/assets/icons/ch.svg'
import Github from '@/assets/icons/github.svg'
---

<footer class='mx-2 my-6 text-xs flex justify-between text-ui-500'>
  <p class='flex gap-3'>
    © 2026 Francisco Engler
    <a
      class='flex gap-1'
      href='https://github.com/heliacer/site'
      target='_blank'
      rel='noopener noreferrer'
    >
      <Github class='w-3' />
      Source
    </a>
  </p>
  <p class='flex items-center gap-2'>
    Zürich, CH
    <CH
      aria-hidden='true'
      id='chIcon'
      class='rounded-sm w-3 h-3 opacity-80 hover:scale-115'
    />
  </p>
</footer>
