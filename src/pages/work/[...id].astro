---
import '@/styles/prose.css'
import { getCollection, getEntry, render } from 'astro:content'
import type { InferGetStaticPropsType } from 'astro'
import Layout from '@/layout.astro'
import Back from '@/components/Back.astro'
import { proseStyles } from '@/components/shared'

export async function getStaticPaths() {
  const posts = await getCollection('work')

  return posts.map(post => ({
    params: { id: post.id },
    props: { post }
  }))
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>

const { post } = Astro.props
const { Content } = await render(post)

const date = post.data.upd ?? post.data.pub

/** for block back button */
const cut = post.id.lastIndexOf('/')
const parent = cut === -1 ? null : await getEntry('work', post.id.slice(0, cut))
const href = parent ? `/work/${parent.id}` : '/work/'
const label = parent?.data.title ?? 'Work'

const posting = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.descr,
  datePublished: post.data.pub.toISOString(),
  dateModified: date.toISOString(),
  author: {
    '@type': 'Person',
    '@id': 'https://heliacer.ch/#person',
    name: 'Francisco Engler',
    url: 'https://heliacer.ch'
  },
  url: new URL(Astro.url.pathname, Astro.site).href
}
---

<Layout
  title={post.data.title}
  description={post.data.descr}
  cover={post.data.cover}
  noindex={post.data.noindex}
>
  <script
    is:inline
    type='application/ld+json'
    set:html={JSON.stringify(posting)}
  />
  <Back href={href}>{label}</Back>
  <main class='max-w-2xl mx-auto 2xl:mx-0'>
    <header>
      <h1 class='text-4xl my-4'>
        <span class='text-amber'>{post.data.title.charAt(0)}</span>
        {post.data.title.substring(1)}
      </h1>
    </header>
    <article class:list={proseStyles}>
      <Content />
    </article>
    <p class='text-sm text-ui-500 my-4'>
      {post.data.upd ? 'Last updated ' : 'Published '}
      <time datetime={date.toISOString()}>{date.toLocaleDateString()}</time>
    </p>
    <div class='giscus'></div>
    <script is:inline>
      {
        const theme = () =>
          document.documentElement.classList.contains('dark') ? 'dark' : 'light'

        const s = document.createElement('script')
        s.src = 'https://giscus.app/client.js'
        s.async = true
        s.crossOrigin = 'anonymous'
        Object.assign(s.dataset, {
          repo: 'heliacer/site',
          repoId: 'R_kgDOR8Tf7Q',
          category: 'Announcements',
          categoryId: 'DIC_kwDOR8Tf7c4DLQr7',
          mapping: 'pathname',
          strict: '1',
          reactionsEnabled: '1',
          emitMetadata: '0',
          inputPosition: 'top',
          lang: 'en',
          loading: 'lazy',
          theme: theme()
        })
        document.currentScript.after(s)

        new MutationObserver(() =>
          document
            .querySelector('iframe.giscus-frame')
            ?.contentWindow.postMessage(
              { giscus: { setConfig: { theme: theme() } } },
              'https://giscus.app'
            )
        ).observe(document.documentElement, { attributeFilter: ['class'] })
      }
    </script>
  </main>
</Layout>
