---
import Layout from '@/layout.astro'
import Card from '@/components/Card.astro'
import { ArrowLeftRight, Rss } from '@lucide/astro'
import { getCollection } from 'astro:content'
import Back from '@/components/Back.astro'

const posts = (await getCollection('work')).sort((a, b) => {
  const aTime = a.data.upd ?? a.data.pub
  const bTime = b.data.upd ?? b.data.pub
  return bTime.getTime() - aTime.getTime()
})

const tags = [...new Set(posts.flatMap(post => post.data.tags))].sort()

const line = 'Projects, Articles, and other Stuff'
---

<Layout title='Work' description={line}>
  <Back href='/'>Home</Back>
  <main class='grid gap-x-4 md:grid-cols-[1fr_13.5rem]'>
    <header>
      <h1 class='text-4xl my-4'>
        <span class='text-amber'>W</span>ork
      </h1>
      <p class='text-ui-400'>{line}</p>
    </header>
    <nav class='md:w-54 md:col-start-2 md:row-start-1 md:row-span-2'>
      <aside
        class:list={[
          'flex flex-col gap-3 py-4 border-b border-dashed border-ui-800',
          'md:fixed md:inset-y-20 md:w-54 md:py-0 md:pl-4 md:border-b-0 md:border-l'
        ]}
      >
        <h2 class='hidden md:block my-1'>Navigation</h2>
        <div class='flex gap-2 items-center text-sm'>
          Sort by:
          <span id='sortLabel' class='italic ml-auto w-12'>
            newest
          </span>
          <button
            id='sortButton'
            class:list={[
              'p-1 rounded-md bg-ui-900 md:bg-transparent hover:bg-ui-900',
              'border border-transparent active:border-ui-950'
            ]}
          >
            <ArrowLeftRight size={16} />
          </button>
        </div>
        <input
          id='search'
          type='search'
          placeholder='Search...'
          class='py-1.25 px-2.5 w-full text-sm rounded-lg bg-ui-900/50'
        />
        <div
          id='tags'
          class='flex gap-x-1.5 gap-y-2 overflow-x-auto md:flex-wrap md:max-h-30 md:overflow-y-auto'
        >
          {tags.map(tag => (
            <button
              data-tag={tag}
              aria-pressed='false'
              class:list={[
                'shrink-0 rounded-md px-1.5 py-px text-xs',
                'border border-transparent',
                'bg-ui-900/50 text-ui-400 hover:text-ui-200/80',
                'aria-pressed:bg-amber/20 aria-pressed:text-ui-300'
              ]}
            >
              # {tag}
            </button>
          ))}
        </div>
        <a
          href='/rss.xml'
          class:list={[
            'hidden md:flex text-sm gap-2 items-center',
            'underline underline-offset-4 decoration-amber',
            'hover:decoration-amber/80'
          ]}
        >
          <Rss size={14} />
          rss.xml
        </a>
      </aside>
    </nav>
    <ul
      id='posts'
      class='md:col-start-1 min-w-0 my-4 grid lg:grid-cols-2 2xl:grid-cols-3 gap-4'
    >
      {posts.map(post => (
        <Card id={post.id} work={post.data} />
      ))}
    </ul>
  </main>
</Layout>

<script>
  const list = document.getElementById('posts')!
  const cards = list.children as HTMLCollectionOf<HTMLElement>
  const search = document.getElementById('search') as HTMLInputElement
  const active = new Set<string>()

  function filter() {
    const q = search.value.trim().toLowerCase()
    for (const card of cards) {
      const tags = card.dataset.tags!.split(' ')
      card.hidden =
        !card.textContent!.toLowerCase().includes(q) ||
        ![...active].every(tag => tags.includes(tag))
    }
  }

  search.addEventListener('input', filter)
  document.getElementById('tags')!.addEventListener('click', e => {
    const button = (e.target as HTMLElement).closest('button')
    if (!button) return
    const tag = button.dataset.tag!
    const on = !active.delete(tag)
    if (on) active.add(tag)
    button.setAttribute('aria-pressed', String(on))
    filter()
  })

  const sortLabel = document.getElementById('sortLabel')!
  let newest = true
  document.getElementById('sortButton')!.addEventListener('click', () => {
    newest = !newest
    sortLabel.textContent = newest ? 'newest' : 'oldest'
    list.append(...[...cards].reverse())
  })
</script>
