---
import '@/styles/prose.css'
import { getCollection, getEntry, render } from 'astro:content'
import type { InferGetStaticPropsType } from 'astro'
import Layout from '@/layout.astro'
import Back from '@/components/Back.astro'

export async function getStaticPaths() {
  const posts = await getCollection('blog')

  return posts.map(post => ({
    params: { id: post.id },
    props: { post }
  }))
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>

const { post } = Astro.props
const { Content } = await render(post)

const date = post.data.upd ?? post.data.pub

/** for block back button */
const cut = post.id.lastIndexOf('/')
const parent = cut === -1 ? null : await getEntry('blog', post.id.slice(0, cut))
const href = parent ? `/blog/${parent.id}/` : '/blog/'
const label = parent?.data.title ?? 'Blog'

const posting = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.descr,
  datePublished: post.data.pub.toISOString(),
  dateModified: date.toISOString(),
  author: {
    '@type': 'Person',
    '@id': 'https://heliacer.ch/#person',
    name: 'Francisco Engler',
    url: 'https://heliacer.ch'
  },
  url: new URL(Astro.url.pathname, Astro.site).href
}
---

<Layout
  title={post.data.title}
  description={post.data.descr}
  cover={post.data.cover}
  noindex={post.data.noindex}
>
  <script is:inline type='application/ld+json' set:html={JSON.stringify(posting)} />
  <Back href={href}>{label}</Back>
  <main class='max-w-2xl mx-auto 2xl:mx-0'>
    <header>
      <h1 class='text-4xl my-4'>
        <span class='text-amber'>{post.data.title.charAt(0)}</span>
        {post.data.title.substring(1)}
      </h1>
    </header>
    <article
      class:list={[
        'prose prose-zinc max-w-none dark:prose-invert',
        'prose-img:rounded-md prose-a:underline-offset-4',
        'prose-headings:font-normal prose-a:hover:decoration-amber/80',
        'prose-a:decoration-amber prose-hr:border-dashed',
        'prose-blockquote:rounded-sm prose-blockquote:border-amber/40'
      ]}
    >
      <Content />
    </article>
    <p class='text-sm text-ui-500 my-4'>
      {post.data.upd ? 'Last updated ' : 'Published '}
      <time datetime={date.toISOString()}>{date.toLocaleDateString()}</time>
    </p>
    <script
      src='https://utteranc.es/client.js'
      data-repo='heliacer/site'
      data-issue-term='pathname'
      data-label='Comment'
      data-theme='github-dark'
      crossorigin='anonymous'
      async
      is:inline
    ></script>
  </main>
</Layout>
