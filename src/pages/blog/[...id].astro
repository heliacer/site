---
import '@/styles/prose.css'
import { getCollection, render } from 'astro:content'
import type { InferGetStaticPropsType } from 'astro'
import Layout from '@/layout.astro'
import BlogHeader from '@/components/BlogHeader.astro'

export async function getStaticPaths() {
  const posts = await getCollection('blog')

  return posts.map(post => ({
    params: { id: post.id },
    props: { post }
  }))
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>

const { post } = Astro.props
const { Content } = await render(post)
---

<Layout title={post.data.title}>
  <BlogHeader blog={post.data} id={post.id} />
  <main>
    <article
      class:list={[
        'prose max-w-2xl mx-auto prose-zinc dark:prose-invert',
        'prose-img:rounded-md prose-a:underline-offset-4',
        'prose-headings:font-normal prose-a:hover:decoration-amber/80',
        'prose-a:decoration-amber prose-hr:border-dashed',
        'prose-blockquote:rounded-sm prose-blockquote:border-amber/40'
      ]}
    >
      <Content />
    </article>
  </main>
</Layout>
