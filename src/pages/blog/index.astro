---
import Layout from '@/layout.astro'
import BlogCard from '@/components/BlogCard.astro'
import { ArrowLeftRight, Rss } from '@lucide/astro'
import { getCollection } from 'astro:content'
import Back from '@/components/Back.astro'

const posts = (await getCollection('blog')).sort((a, b) => {
  const aTime = a.data.upd ?? a.data.pub
  const bTime = b.data.upd ?? b.data.pub
  return bTime.getTime() - aTime.getTime()
})
---

<Layout
  title='Blog'
  description='Projects and stuff, mostly written in English'
>
  <Back href='/'>Home</Back>
  <main class='flex gap-4'>
    <main class='flex-1 min-w-0'>
      <h1 class='text-4xl my-4'>
        <span class='text-amber'>B</span>log
      </h1>
      <p class='text-ui-400'>Projects and stuff, mostly written in English</p>
      <ul id='posts' class='my-4 grid lg:grid-cols-2 2xl:grid-cols-3 gap-4'>
        {posts.map(post => (
          <BlogCard id={post.id} blog={post.data} />
        ))}
      </ul>
    </main>
    <div class='hidden md:block w-54 shrink-0'>
      <aside class='fixed inset-y-20 w-54 pl-4 border-l border-dashed border-ui-800'>
        <h2 class='my-4'>Navigation</h2>
        <div class='flex gap-2 items-center text-sm'>
          Sort by:
          <span id='sortLabel' class='italic ml-auto w-12'>
            newest
          </span>
          <button
            id='sortButton'
            class:list={[
              'p-1 rounded-md hover:bg-ui-900',
              'border border-transparent active:border-ui-950'
            ]}
          >
            <ArrowLeftRight size={16} />
          </button>
        </div>
        <input
          id='blogsearch'
          type='search'
          placeholder='Search...'
          class='my-4 py-1.25 px-2.5 w-full text-sm rounded-lg bg-ui-900/50'
        />
        <a
          href='/rss.xml'
          class:list={[
            'text-sm flex gap-2 items-center',
            'underline underline-offset-4 decoration-amber',
            'hover:decoration-amber/80'
          ]}
        >
          <Rss size={14} />
          rss.xml
        </a>
      </aside>
    </div>
  </main>
</Layout>

<script>
  const sortButton = document.getElementById('sortButton')!
  const sortLabel = document.getElementById('sortLabel')!
  const list = document.getElementById('posts')!

  let newest = true
  sortButton.addEventListener('click', () => {
    newest = !newest
    sortLabel.textContent = newest ? 'newest' : 'oldest'
    list.append(...[...list.children].reverse())
  })

  const search = document.getElementById('blogsearch') as HTMLInputElement
  search.addEventListener('input', () => {
    const q = search.value.trim().toLowerCase()
    for (const card of list.children as HTMLCollectionOf<HTMLElement>)
      card.hidden = !card.textContent!.toLowerCase().includes(q)
  })
</script>
